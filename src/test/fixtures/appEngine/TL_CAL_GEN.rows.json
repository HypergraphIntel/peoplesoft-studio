 "sqlText": [
  {
   "SQLID": "TL_CAL_GEN  LOOP    Step020 H",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "%Select(TL_TA_MAIN_AET.TEMP_FLD) SELECT 'X' FROM PS_TL_INSTALLATION WHERE %Bind(PERIOD_TYPE) = 'FM' AND %Bind(SUBTYPE_IND) = 'SM' AND %Bind(OFFSET_DAYS) <> 1"
  },
  {
   "SQLID": "TL_CAL_GEN  LOOP    Step030 H",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "%Select(PERIOD_SEQUENCE) SELECT A.PERIOD_SEQUENCE FROM PS_TL_CALENDAR A ,PS_TL_CALENDAR B WHERE A.PERIOD_ID = %Bind(PERIOD_ID) AND A.PERIOD_ID = B.PERIOD_ID AND A.END_DT BETWEEN B.START_DT AND B.END_DT AND A.PERIOD_SEQUENCE < B.PERIOD_SEQUENCE"
  },
  {
   "SQLID": "TL_CAL_GEN  LOOP    Step020 S",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "UPDATE PS_TL_CALENDAR SET START_DT = %DateAdd(START_DT,%Bind(OFFSET_DAYS) - 1) ,END_DT = %DateAdd(END_DT, %Bind(OFFSET_DAYS) -1) WHERE PERIOD_TYPE = 'FM' AND PERIOD_ID = %Bind(PERIOD_ID) AND START_DT BETWEEN %Bind(START_DT) AND %Bind(END_DT)"
  },
  {
   "SQLID": "TL_CAL_GEN  LOOP    Step030 S",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "DELETE FROM PS_TL_CALENDAR WHERE PERIOD_ID = %Bind(PERIOD_ID) AND PERIOD_SEQUENCE <= %Bind(PERIOD_SEQUENCE)"
  },
  {
   "SQLID": "TL_CAL_GEN  MAIN    Step01  D",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": " %Select(START_DT,END_DT,START_WEEK_DAY_IND,OVERRIDE_IND,PERIOD_ID,PERIOD_TYPE,PERIOD_LENGTH,OFFSET_DAYS,START_DAY_OF_WEEK,SUBTYPE_IND) SELECT %DateOut(RC2.START_DT) ,%DateOut(RC2.END_DT) ,RC.START_WEEK_DAY_IND ,RC.OVERRIDE_IND ,T.PERIOD_ID ,T.PERIOD_TYPE ,T.PERIOD_LENGTH ,T.OFFSET_DAYS ,T.START_DAY_OF_WEEK ,T.SUBTYPE_IND FROM PS_TL_RUN_CTRL_CAL RC ,PS_TL_CAL_CTRL_TBL RC2 , PS_TL_TIME_PERIODS T WHERE RC.OPRID=%Bind(OPRID) AND RC.RUN_CNTL_ID=%Bind(RUN_CNTL_ID) AND RC.OPRID=RC2.OPRID AND RC.RUN_CNTL_ID=RC2.RUN_CNTL_ID AND T.PERIOD_TYPE<>'CO' AND T.PERIOD_ID<>'NONE' AND (RC.SCOPE_IND='ALL' OR (RC.SCOPE_IND='TYP' AND T.PERIOD_TYPE IN ( SELECT PERIOD_TYPE1 FROM PS_TL_RUN_CAL_OPT1 T2 WHERE T2.RUN_CNTL_ID=RC.RUN_CNTL_ID)) OR (RC.SCOPE_IND='HOC' AND T.PERIOD_ID IN ( SELECT PERIOD_ID FROM PS_TL_RUN_CAL_OPT1 T2 WHERE T2.RUN_CNTL_ID=RC.RUN_CNTL_ID)))"
  }
 ],
