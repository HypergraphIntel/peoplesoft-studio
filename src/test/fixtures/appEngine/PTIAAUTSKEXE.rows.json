 "messages": [],
 "sqlText": [
  {
   "SQLID": "PTIAAUTSKEXEMAIN    Step02  S",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "%Selectinit(RUNCONTROLID)   SELECT %runcontrol   FROM %SelectDummyTable;"
  },
  {
   "SQLID": "PTIAAUTSKEXEMAIN    Step03  H",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": " %SelectInit(PTIAAUTASKID)   SELECT A.PTIAAUTASKID   FROM %Table(PTIAAUTASK) A   WHERE A.PTIAAUTASKID = %Substring(%Bind(RUNCONTROLID),6)   AND EXISTS(   SELECT B.PTIAAUJOBID   FROM %Table(PTIAAUJOB) B   WHERE B.PTIAAUJOBID = A.PTIAAUJOBID)"
  },
  {
   "SQLID": "PTIAAUTSKEXEMAIN    Step04  H",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": " %SelectInit(PTIAAULOGMESSAGE)   SELECT PTIAAULOGMESSAGE   FROM %Table(PTIAAU_EXCP_STG)"
  },
  {
   "SQLID": "PTIAAUTSKEXEMAIN    Step05  S",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "%truncatetable(%table(PTIAAU_EXCP_STG))"
  },
  {
   "SQLID": "PTIAAUTSKEXEMAIN    Step06  H",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "%SelectInit(PTIAAUTASKSTATE)   SELECT B.PTIAAUTASKSTATE   FROM %Table(PTIAAUTASK) B   WHERE B.PTIAAUTASKID = %Bind(PTIAAUTASKID)"
  },
  {
   "SQLID": "PTIAAUTSKEXETSKEXCP Step01  S",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "INSERT INTO %Table(PTIAAU_EXCP_STG) (PTIAAULOGMESSAGE)   VALUES (%TextIn(%bind(PTIAAULOGMESSAGE)))"
  },
  {
   "SQLID": "PTIAAUTSKEXETSKWAIT Step01  N",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": "%SelectInit(PTIAAUTASKSTATE)   SELECT B.PTIAAUTASKSTATE   FROM %Table(PTIAAUTASK) B   WHERE B.PTIAAUTASKID = %Bind(PTIAAUTASKID)   AND B.PTIAAUTASKSTATE IN ('COMPLETED', 'FAILED', 'ABORT', 'DEAD','MANUAL STOP')"
  },
  {
   "SQLID": "PTIAAUTSKEXETSKWAIT Step01  W",
   "MARKET": "GBL",
   "DBTYPE": " ",
   "EFFDT": "1900-01-01",
   "SEQNUM": 0,
   "SQLTEXT": " %SelectInit(PTIAAUTASKSTATE)   SELECT A.PTIAAUTASKSTATE   FROM %Table(PTIAAUTASK) A   WHERE A.PTIAAUTASKID = %Bind(PTIAAUTASKID)   AND EXISTS(   SELECT B.PTIAAUJOBSTATE   FROM %Table(PTIAAUJOB) B   WHERE B.PTIAAUJOBID = A.PTIAAUJOBID)   AND NOT EXISTS(   SELECT 'X'   FROM %Table(PTIAAU_EXCP_STG))"
  }
 ],
