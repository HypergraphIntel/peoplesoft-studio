{
  "$id": "https://peoplesoft-studio.invalid/schema/psft-finding/1/finding-input.json",
  "title": "psft-finding/1 finding input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "metadata-mapping",
        "save-protocol",
        "serialization",
        "bytecode-pattern",
        "version-difference",
        "object-relationship",
        "roundtrip-comparison",
        "compile-difference",
        "behavior"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "subsystem": {
          "type": "string",
          "enum": [
            "page-designer",
            "component",
            "record",
            "field",
            "menu",
            "app-engine",
            "peoplecode",
            "application-class",
            "component-interface",
            "message-channel",
            "integration-broker",
            "project",
            "sql",
            "html",
            "style-sheet",
            "customization",
            "event-mapping",
            "portal-registry",
            "security",
            "build",
            "other"
          ]
        },
        "objectType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "tables": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_#@$.:-]{0,63}$"
          }
        },
        "properties": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_#@$.:-]{0,63}$"
          }
        }
      },
      "required": [
        "subsystem",
        "objectType"
      ],
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_#@$.:-]{0,63}$"
        },
        "facts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_#@$.:-]{0,63}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "maxProperties": 64
        }
      },
      "required": [
        "kind",
        "facts"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "knownIncompatible": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d\\.\\d{2}(\\.\\d{2})?$"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "research-harness",
        "manual",
        "extension",
        "mcp-agent"
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "method": {
          "type": "string",
          "enum": [
            "save-capture",
            "controlled-compile",
            "corpus-harness",
            "live-e2e",
            "pia-capture",
            "unit-replay",
            "source-inspection",
            "manual-inspection"
          ]
        },
        "experimentId": {
          "type": "string",
          "maxLength": 120
        },
        "runId": {
          "type": "string",
          "maxLength": 120
        },
        "environment": {
          "type": "object",
          "properties": {
            "peopleToolsRelease": {
              "type": "string",
              "pattern": "^\\d\\.\\d{2}(\\.\\d{2})?$"
            },
            "appRelease": {
              "type": "string",
              "maxLength": 64
            },
            "appFamily": {
              "type": "string",
              "enum": [
                "HCM",
                "FSCM",
                "CS",
                "ELM",
                "CRM",
                "IH",
                "PeopleTools",
                "other"
              ]
            },
            "platform": {
              "type": "string",
              "enum": [
                "oracle",
                "mssql",
                "db2"
              ]
            },
            "tool": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "peopleToolsRelease"
          ],
          "additionalProperties": false
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expected": {
          "type": "string",
          "maxLength": 2000
        },
        "actual": {
          "type": "string",
          "maxLength": 2000
        },
        "reproduction": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "delta": {
          "type": "object",
          "properties": {
            "tables": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_#@$.:-]{0,63}$"
                  },
                  "inserted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "deleted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "updated": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "table",
                  "inserted",
                  "deleted",
                  "updated"
                ],
                "additionalProperties": false
              }
            },
            "counters": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_#@$.:-]{0,63}$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "tables"
          ],
          "additionalProperties": false
        },
        "testResults": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "skip"
                ]
              }
            },
            "required": [
              "name",
              "outcome"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "repo-path",
                  "capture-case",
                  "test",
                  "doc",
                  "commit"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "observedAt",
        "method",
        "environment",
        "observation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "subject",
    "assertion",
    "title",
    "statement",
    "confidence",
    "source",
    "observation"
  ],
  "additionalProperties": false
}
