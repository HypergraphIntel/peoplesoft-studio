# Git / editor metadata
.git/**
.gitignore
.vscode/**

# Documentation not needed in VSIX
docs/**

# Dependencies esbuild bundles into dist/extension.js. Only oracledb is
# loaded from node_modules at runtime (import("oracledb")); vscode is the
# host. Listed explicitly: a negation would override the oracledb trimming
# below, and a dependency added later ships by default (safe, only larger).
node_modules/@modelcontextprotocol/**
node_modules/zod/**
node_modules/hono/**
node_modules/@hono/**

# OracleDB non-runtime material
node_modules/oracledb/examples/**
node_modules/oracledb/package/**
node_modules/oracledb/plugins/**
node_modules/oracledb/README.md
node_modules/oracledb/SECURITY.md
node_modules/oracledb/CHANGELOG.md
node_modules/oracledb/NOTICE.txt
node_modules/oracledb/THIRD_PARTY_LICENSES.txt