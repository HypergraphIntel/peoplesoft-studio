  "assertion": {
    "kind": "level-rule",
    "facts": {
      "column": "PSPNLFIELD.OCCURSLEVEL",
      "order": "FIELDNUM",
      "start": 0,
      "setters": "FIELDTYPE 10,19,27,32; FIELDTYPE 23 with FIELDUSE 0x2",
      "position": "ignored"
    }
  },
  "title": "App Designer stores each page control's OCCURSLEVEL from tab order: a running level that each scroll and each Set to Level rule sets to its own",
  "statement": "On every page save App Designer assigns PSPNLFIELD.OCCURSLEVEL by walking the controls in tab order (FIELDNUM) with a running level from 0: a Scroll Bar, Grid, Scroll Area or Analytic Grid (FIELDTYPE 10, 19, 27, 32) keeps its own level and the running level becomes it, as does a Horizontal Rule with Set to Level (FIELDTYPE 23, FIELDUSE 0x2); every other control takes the running level. Where a control sits on the page plays no part. Checked against the whole page after each of 16 App Designer saves that inserted scrolls and rules, changed levels and reordered controls.",
  "confidence": "high",
  "compatibility": {
    "observedReleases": [
      "8.62.09"
    ],
    "knownIncompatible": []
  },
  "localStatus": "reproduced",
