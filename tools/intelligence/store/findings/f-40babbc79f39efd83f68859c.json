  "title": "After an App Engine section's market is re-keyed, App Designer leaves PSSQLHASH.MARKET unchanged until a later save",
  "statement": "Changing a section's market re-keys its SQL text (PSSQLTEXTDEFN, PSAESTMTDEFN) to the new market, but App Designer does not update the SQL's PSSQLHASH row; a later save touching the program's SQL updates its MARKET. A writer that keeps PSSQLHASH in step differs from App Designer only in that column.",
  "confidence": "medium",
  "compatibility": {
    "observedReleases": [
      "8.62.09"
    ],
    "knownIncompatible": []
  },
  "localStatus": "reproduced",
