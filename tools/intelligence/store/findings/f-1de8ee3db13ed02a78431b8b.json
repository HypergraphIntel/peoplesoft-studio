  "assertion": {
    "kind": "insert-placement",
    "facts": {
      "column": "PSPNLFIELD.FIELDNUM",
      "rule": "after the last control at or above-left of the drop point",
      "rowBand": 20,
      "selection": "ignored",
      "exception": "Secondary Page (sp-fresh)"
    }
  },
  "title": "App Designer puts a new page control right after the control before it in reading order, not after the selection or at the end",
  "statement": "An inserted page control (not a scroll or grid column) takes the FIELDNUM right after the last control, in tab order, that is at or above-left of its drop point in reading order -- two controls on one row when their tops are within 20 units, then left to right -- or the first FIELDNUM when none is; the controls after it move down one. The selected control and the end of the tab order play no part. Checked against the page before each of 19 single App Designer inserts; one Secondary Page insert (sp-fresh) went one place earlier than this gives and is not covered.",
  "confidence": "high",
  "compatibility": {
    "observedReleases": [
      "8.62.09"
    ],
    "knownIncompatible": []
  },
