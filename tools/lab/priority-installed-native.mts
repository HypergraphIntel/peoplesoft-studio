 for(const name of ['migration-installed-before','migration-installed-after','recovery-installed-inverse','recovery-installed-redo',...(resumeInverse?['recovery-installed-paused-inverse']:[])])await copyFile(control.dir+'/'+name+'.png','tools/lab/results/'+name+(resumeInverse?'-resumed':'')+'-2026-10-20.png');report.passed=true;
