 await check('Installed Import command opens durable exact target review without writes; rendered primary action applies both menus and project',async()=>{migration=await wait(async()=>{const s=await get(migration.id);return s.status==='READY_FOR_REVIEW'?s:false;},'migration validation');assert.equal(migration.objects.length,3);assert.ok(migration.objects.every((o:any)=>o.review==='PENDING'&&o.application==='PENDING'));await open(migration);await ui.screenshot(control.dir+'/migration-installed-before.png');await click(migration,'approveAndApply');migration=await applied(migration);assert.ok(migration.objects.every((o:any)=>o.application==='VERIFIED'));for(const a of pkg.assets)assert.deepEqual((await p.readMenuForMigration(a.data.name))!.data,a.data);assert.equal((await p.listProjectItems(pkg.project)).length,2);await ui.screenshot(control.dir+'/migration-installed-after.png');report.migrationSet=migration.id;});
 assert.equal((await p.readStructuredCreationForReview('record',record)).value,null);assert.equal((await p.readStructuredCreationForReview('ae',program)).value,null);creationOwned=true;
 const rp=await p.saveRecord({operatorId,dryRun:true,captureSnapshots:true,edit:{recname:record,recordType:2,openedVersion:0,isNew:true,fields:[{name:'PROCESS_INSTANCE',useEdit:1,isNew:true},{name:'DESCR',useEdit:0,isNew:true}]}});assert.ok(rp.creationPreview);const rv=rp.creationPreview.after.value;
 const doc=documentFromSpec({program,disableRestart:true,stateRecords:[{record,default:true}],sections:[{name:'MAIN',steps:[{name:'INIT',actions:[{type:'PeopleCode',peopleCode:'Local number &count = 1;\n'}]}]}]});const ap=await p.saveAppEngineDocument({doc,openedToken:'absent',operatorId,dryRun:true,captureSnapshots:true});assert.ok(ap.creationPreview);const av=ap.creationPreview.after.value;
 let original=await call('psft_create_change_set',{connection:'HRDMO',title:'Installed native recovery '+prefix});original=await call('psft_stage_object_change',{changeSetId:original.id,adapter:'record-create',key:record,after:rv});original=await call('psft_stage_object_change',{changeSetId:original.id,adapter:'ae-create',key:program,after:av,dependencies:[original.objects[0].id]});original=await call('psft_validate_change_set',{changeSetId:original.id});
 await check('Rendered Approve only then Apply one pauses after the native record and leaves AE absent',async()=>{assert.equal(original.status,'READY_FOR_REVIEW',JSON.stringify(original.objects.map((o:any)=>o.validation)));await open(original);await click(original,'approve');await wait(async()=>{original=await get(original.id);return original.status==='APPROVED';},'approve only');await click(original,'applyOne');original=await wait(async()=>{const s=await get(original.id);return s.status==='PARTIALLY_APPLIED'?s:false;},'pause');assert.equal((await p.readStructuredCreationForReview('record',record)).hash,hash(rv));assert.equal((await p.readStructuredCreationForReview('ae',program)).value,null);await open(original);});
 let leaf=await call('psft_prepare_remaining_work',{changeSetId:original.id});
