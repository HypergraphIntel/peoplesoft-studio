 if(creationOwned){for(const t of ['PSAEAPPLDEL','PSAESECTDEL','PSAEAPPLDEFN','PSAEAPPLSTATE','PSAEAPPLTEMPTBL','PSAEAPPLLANG','PSAESECTDEFN','PSAESECTDTLDEFN','PSAESTEPDEFN','PSAESTMTDEFN','PSAESTEPMSGDEFN'])await c.execute(`DELETE FROM ${t} WHERE AE_APPLID=:n`,{n:program});for(const t of ['PSSQLTEXTDEFN','PSSQLHASH','PSSQLDESCR','PSSQLDEFN','PSSQLDEL'])await c.execute(`DELETE FROM ${t} WHERE SUBSTR(SQLID,1,12)=RPAD(:n,12) AND SQLTYPE IN ('1','6')`,{n:program});for(const t of ['PSPCMPROG','PSPCMTXT','PSPCMNAME','PSPCMPROGDEL'])await c.execute(`DELETE FROM ${t} WHERE OBJECTID1=66 AND OBJECTVALUE1=:n`,{n:program});for(const t of ['PSRECFIELDDB','PSRECFIELD','PSINDEXDEFN','PSKEYDEFN','PSRECTBLSPC','PSRECDEFN','PSRECDEL'])await c.execute(`DELETE FROM ${t} WHERE RECNAME=:n`,{n:record});}await c.commit();}
try{await p.connect();for(const n of menuNames)assert.equal(await p.readMenuForMigration(n),undefined);assert.equal(await p.projectExists(pkg.project),false);assert.equal(Number((await c.execute<{N:number}>('SELECT COUNT(*) AS N FROM PSPROJECTITEM WHERE PROJECTNAME=:n',{n:pkg.project})).rows![0].N),0);menusOwned=true;
 let migration=(await sets()).find(s=>s.title.startsWith('Migrate '+pkg.project)&&['DRAFT','VALIDATING','READY_FOR_REVIEW'].includes(s.status));
