 await check('Complete menu export preserves items, transfer, comments and authoritative ItemSelected source without installation stamps',async()=>{assert.equal(pkg.assets.length,2);assert.ok(pkg.assets.every(a=>a.kind==='menu'));for(const a of pkg.assets)assert.deepEqual(a.data,(await p.readMenuForMigration(a.data.name))!.data);assert.ok(pkg.requirements.some(k=>k.type===DefinitionType.Component));assert.ok(!JSON.stringify(pkg).includes('storedGroup'));});
 await cleanup();
 await check('Vacant target native rollback previews leave menus absent and reviewed dependency order restores both scopes exactly',async()=>{
 const plan=await previewMigrationImport(pkg,target);assert.deepEqual(plan.blockers,[]);for(const name of names)assert.equal(await p.readMenuForMigration(name),undefined);
 const workspace={connections:[],activeProviders:[p],require:async()=>p,isWritable:()=>true,isSqlWritable:()=>true,isPeopleCodeWritable:()=>true,configFor:()=>({peoplesoftOperatorId:operatorId,peoplecodeSaveMode:'compile-and-save'})} as unknown as Workspace;
 const registry=databaseReviewAdapters(workspace,()=>({mode:()=> 'confirm',confirm:async()=>{throw Error('No legacy confirmation path.');},hasUnsavedEditor:()=>false,saved(){}})),service=new ReviewService(new ReviewStore(root),{environment:registry.environment,changed(){}},registry.adapters);
 let set=(await stageMigrationImport(service,p.id,pkg,plan,target,p))!;assert.equal(set.objects.length,3);assert.equal(await p.readMenuForMigration(popup),undefined);set=await service.validate(set.id);assert.equal(set.status,'READY_FOR_REVIEW',JSON.stringify(set.objects.map(c=>c.validation)));set=await service.review(set.id,set.objects.map(o=>o.id),'APPROVED',set.revision);set=await service.apply(set.id);assert.equal(set.status,'APPLIED',JSON.stringify(set.journal));assert.ok(set.objects.every(o=>o.application==='VERIFIED'));for(const a of pkg.assets)assert.deepEqual((await p.readMenuForMigration(a.data.name))!.data,a.data);report.changeSet=set.id;
 });
 await check('Unchanged import preserves native menu/PeopleCode/project counters',async()=>{const counters=async()=>(await c.execute("SELECT OBJECTTYPENAME,VERSION FROM PSVERSION WHERE OBJECTTYPENAME IN ('MDM','PCM','PJM','SYS','CLM') ORDER BY OBJECTTYPENAME")).rows;const before=await counters(),plan=await previewMigrationImport(pkg,target);assert.deepEqual(plan.blockers,[]);assert.ok(plan.changes.every(x=>x.action==='same'));assert.deepEqual((await applyMigrationImport(pkg,plan,target)).completed,[]);assert.deepEqual(await counters(),before);});
 await check('Existing menu item removal and group edits are blocked before writes; unversioned metadata drift changes the full token',async()=>{const before=(await p.readMenuForMigration(standard))!;const asset=pkg.assets.find(a=>a.data.name===standard)!;assert.equal(asset.kind,'menu');if(asset.kind!=='menu')throw Error('menu');const changed=structuredClone(asset);changed.data.bars=[];assert.ok((await target.validate!(changed,before.token,pkg.assets)).some(e=>/remove|errors|menu-empty|item/.test(e)));const group=structuredClone(asset);group.data.groupOrder=1;assert.ok((await target.validate!(group,before.token,pkg.assets)).some(e=>/group settings/.test(e)));await c.execute('UPDATE PSMENUDEFN SET DESCR=:d WHERE MENUNAME=:n',{d:'Unversioned outside edit',n:standard});await c.commit();const drift=(await p.readMenuForMigration(standard))!;assert.equal(drift.writerToken,before.writerToken);assert.notEqual(drift.token,before.token);await assert.rejects(p.saveMenuDocument({doc:asset.data,openedToken:before.writerToken,expectedSnapshotToken:before.token,operatorId}),/changed after preview/);});
 report.passed=true;
}catch(error){report.error=error instanceof Error?error.message:String(error);throw error;}finally{try{await cleanup();report.cleanupVerified=owned?(await Promise.all(names.map(n=>p.readMenuForMigration(n)))).every(x=>x===undefined)&&!(await p.projectExists(project)):true;}finally{await writeFile('tools/lab/results/menu-migration-native-2026-10-20.json',JSON.stringify(report,null,2)+'\n');await c.close();await pool.close();await p.dispose();await rm(root,{recursive:true,force:true});}}
