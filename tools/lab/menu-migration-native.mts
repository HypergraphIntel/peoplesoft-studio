 let s=insertItem(insertBar(newMenu(standard,0),{name:'USE',label:'Use'}).doc,'USE',{name:'PERSON',type:5,label:'Person',component:component.PNLGRPNAME,market:component.MARKET}).doc;s.descr='Migration standard';s.descrlong='Full scoped menu payload';
 let u=insertItem(newMenu(popup,1),'MENUITEM1',{name:'RUN',type:9,label:'Run',peopleCode:'MessageBox(0, "", 0, 0, "Migration");\r\n'}).doc;
 u=insertItem(u,'MENUITEM1',{name:'OPEN',type:12,label:'Open person',transfer:{menu:standard,component:component.PNLGRPNAME,market:component.MARKET}}).doc;u.descr='Migration popup';
 for(const doc of [s,u])await p.saveMenuDocument({doc,openedToken:'absent',operatorId});const cp=await p.createProject({project,operatorId});await p.saveProject({project,operatorId,openedVersion:cp.version,add:names.map(n=>makeKey(DefinitionType.Menu,n))});
 const pkg=await exportMigrationPackage(p,project),target=await databaseMigrationTarget(p,operatorId);
