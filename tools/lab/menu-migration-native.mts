const checks:string[]=[],report:Record<string,unknown>={checkedAt:new Date().toISOString(),scope:'Disposable HRDMO standard/popup menus including native ItemSelected binary and transfers; no permission-list changes; same-database source/vacant target; trusted service approval, not installed UI',names,project,checks};
