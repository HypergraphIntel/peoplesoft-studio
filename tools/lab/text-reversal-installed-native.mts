/** Unmodified installed VSIX: complete text creation, paused undo/continuation and full redo against HRDMO. */
import assert from 'node:assert/strict';import {readFile,writeFile,copyFile} from 'node:fs/promises';import {createRequire} from 'node:module';import {randomBytes} from 'node:crypto';
import {DatabaseProvider} from '../../src/providers/database.js';import {openDatabase} from '../../src/db/open.js';import {makeKey} from '../../src/model/definitions.js';import {documentFromSpec} from '../../src/model/aeSpec.js';import {hash,reviewStateToken} from '../../src/changeReview/model.js';import {setWriteNamePrefix} from '../../src/providers/writeScope.js';
const control=JSON.parse(await readFile('/tmp/psft-build-handoff-control.json','utf8'));assert.equal(control.privateHistory,true,'Private test history is mandatory.');
const ui=await createRequire(import.meta.url)('../../scripts/peoplecode-editor-cdp.cjs').connectWorkbench(control.cdpUrl);
const command=async(body:unknown)=>{const r=await fetch(control.url,{method:'POST',headers:{authorization:'Bearer '+control.token,'content-type':'application/json'},body:JSON.stringify(body),signal:AbortSignal.timeout(60000)}).then(r=>r.json()) as any;assert.ok(r.ok,r.error);return r.data;};
let seq=0;async function call(name:string,args:unknown):Promise<any>{const r=await fetch(control.mcpUrl,{method:'POST',headers:{'content-type':'application/json',accept:'application/json, text/event-stream'},body:JSON.stringify({jsonrpc:'2.0',id:++seq,method:'tools/call',params:{name,arguments:args}}),signal:AbortSignal.timeout(60000)});const s=await r.text(),body=JSON.parse(s.startsWith('{')?s:s.split('\n').find(l=>l.startsWith('data:'))!.slice(5));assert.ok(!body.error,JSON.stringify(body.error));assert.ok(!body.result.isError,body.result.content?.[0]?.text);return JSON.parse(body.result.content[0].text);}
const pause=(ms:number)=>new Promise(r=>setTimeout(r,ms));async function wait<T>(fn:()=>Promise<T|false|undefined|null>,label:string):Promise<T>{for(let i=0;i<300;i++){const r=await fn();if(r)return r as T;await pause(100);}throw Error('Timed out: '+label);}
const get=(id:string)=>call('psft_get_change_set',{changeSetId:id});const sets=async()=>((await call('psft_list_change_sets',{})).changeSets as any[]);
async function open(set:any){await command({command:'openReview',id:set.id});return wait(async()=>{const page=await ui.webviewAction('PeopleSoft Change Review');return page?.selectedTitle===set.title&&page.reviewToken===reviewStateToken(set)&&page.busy!=='true'?page:false;},'review '+set.id);}
async function click(set:any,action:string){await wait(async()=>{const page=await ui.webviewAction('PeopleSoft Change Review');return page?.selectedTitle===set.title&&page.reviewToken===reviewStateToken(set)&&page.busy!=='true'&&page.buttons.some((b:any)=>b.action===action&&!b.disabled);},'enabled '+action);await ui.webviewAction('PeopleSoft Change Review','click',action);}
async function applied(set:any){const result=await wait(async()=>{const s=await get(set.id);if(['CONFLICTED','FAILED','PARTIALLY_APPLIED'].includes(s.status))throw Error('Apply failed: '+JSON.stringify(s.journal));return s.status==='APPLIED'?s:false;},'APPLIED');await wait(async()=>{const page=await ui.webviewAction('PeopleSoft Change Review');return page?.selectedTitle===result.title&&page.status==='APPLIED'&&page.reviewToken===reviewStateToken(result)&&page.busy!=='true';},'final UI render');return result;}
async function approveApply(set:any,destructive=false){await call('psft_validate_change_set',{changeSetId:set.id});set=await get(set.id);assert.equal(set.status,'READY_FOR_REVIEW',JSON.stringify(set.objects.map((o:any)=>o.validation)));await open(set);if(destructive){await ui.webviewAction('PeopleSoft Change Review','checkbox','destructive');const refreshed=await open(set);assert.equal(refreshed.checkboxes.find((c:any)=>c.id==='destructive')?.checked,true,'Exact-state refresh must retain explicit destructive consent.');}await click(set,'approveAndApply');return applied(set);}
const prefix='ZZ_BU'+randomBytes(3).toString('hex').toUpperCase(),names={sql:prefix+'S',stylesheet:prefix+'C',html:prefix+'H'};
const config={name:'HRDMO installed text reversal',platform:'oracle' as const,connectString:process.env.PSLAB_ORACLE??'127.0.0.1:15210/hrdmo',user:process.env.PSLAB_ACCESSID!,password:process.env.PSLAB_ACCESSPSWD!};assert.match(config.connectString,/hrdmo/i);assert.ok(config.user&&config.password);
const p=new DatabaseProvider(config),pool=await openDatabase('oracle',config),c=await pool.getConnection();let owned=false;
const values={sql:{name:names.sql,text:'SELECT 7 FROM PS_INSTALLATION',description:'Installed full SQL',definition:'Installed complete comments é😀 '.repeat(600),ownerId:'PPT'},
 stylesheet:{name:names.stylesheet,text:'.installedReversal { color: blue; }\r\n'.repeat(700),description:'Installed freeform undo'},
 html:{name:names.html,text:'<link href="%StyleSheet('+names.stylesheet+')">\r\n'+'<div>Installed é😀 undo</div>\r\n'.repeat(900),description:'Installed HTML undo'}};
const checks:string[]=[],report:Record<string,unknown>={checkedAt:new Date().toISOString(),scope:'Unmodified installed production VSIX; actual HRDMO complete text writers, private history, rendered developer controls and full native readback. Original window never reloaded.',bundleSha256:control.bundleSha256,sqlCommentCharacters:values.sql.definition.length,names,checks};
const check=async(label:string,fn:()=>Promise<void>)=>{await fn();checks.push(label);console.log('ok '+checks.length+' - '+label);};
async function paused(set:any){const result=await wait(async()=>{const s=await get(set.id);if(['CONFLICTED','FAILED'].includes(s.status))throw Error(JSON.stringify(s.journal));return s.status==='PARTIALLY_APPLIED'?s:false;},'paused');await open(result);return result;}
async function remaining(set:any){await open(set);await click(set,'remaining');return wait(async()=>(await sets()).find(s=>s.continuation?.changeSetId===set.id),'remaining proposal');}
async function cleanup(){if(!owned)return;await c.rollback();
 for(const t of ['PSSQLTEXTDEFN','PSSQLHASH','PSSQLDESCR','PSSQLDEFN','PSSQLLANG','PSSQLDEL'])await c.execute(`DELETE FROM ${t} WHERE SQLID=:n`,{n:names.sql});
 for(const n of [names.html,names.stylesheet]){for(const t of ['PSCONTENTLANG','PSCONTDEFNLANG','PSCONTENT','PSCONTDEFN','PSCONTDEL'])await c.execute(`DELETE FROM ${t} WHERE CONTNAME=:n`,{n});for(const t of ['PSSTYLECLSLANG','PSSTYLEDFNLANG','PSSTYLECLASS','PSSTYLSHEETDEFN','PSSTYLSHEETDEL'])await c.execute(`DELETE FROM ${t} WHERE STYLESHEETNAME=:n`,{n});}await c.commit();
}
try{
 await p.connect();for(const kind of ['sql','stylesheet','html'] as const)assert.equal((await p.readTextDefinitionForReview(kind,names[kind])).token,'absent');owned=true;
 let original=await call('psft_create_change_set',{connection:'HRDMO',title:'Installed complete text recovery '+prefix});
 await check('Installed MCP stages complete SQL/CSS/HTML without persistence; full SQL metadata remains reviewable',async()=>{
  const catalog=await call('psft_list_change_sets',{});for(const kind of ['sql','html','stylesheet'])assert.ok(catalog.adapters.includes(kind+'-definition'));
  for(const kind of ['sql','stylesheet','html'] as const){const type=kind==='sql'?30:kind==='html'?51:50;await call('psft_save_text_definition',{connection:'HRDMO',type,name:names[kind],text:values[kind].text,description:values[kind].description,changeSetId:original.id,dependsOn:original.objects.length?[original.objects.at(-1).id]:[]});original=await get(original.id);}
  const sql=original.objects.find((o:any)=>o.adapter==='sql-definition');original=await call('psft_stage_object_change',{changeSetId:original.id,adapter:'sql-definition',key:names.sql,objectId:sql.id,after:values.sql});
  values.sql.text='SELECT 8 FROM PS_INSTALLATION';await call('psft_save_text_definition',{connection:'HRDMO',type:30,name:names.sql,text:values.sql.text,changeSetId:original.id});original=await get(original.id);
  for(const kind of ['sql','stylesheet','html'] as const)assert.equal((await p.readTextDefinitionForReview(kind,names[kind])).value,null);
  assert.deepEqual(original.objects.map((o:any)=>o.adapter),['sql-definition','stylesheet-definition','html-definition']);
  await call('psft_validate_change_set',{changeSetId:original.id});original=await get(original.id);assert.equal(original.status,'READY_FOR_REVIEW',JSON.stringify(original.objects.map((o:any)=>o.validation)));await open(original);await ui.screenshot(control.dir+'/text-installed-before.png');
 });
 await check('Rendered approval-only and one-object pause create SQL with full long comments and owner, leaving content absent',async()=>{await click(original,'approve');original=await wait(async()=>{const s=await get(original.id);return s.status==='APPROVED'?s:false;},'original approval');await click(original,'applyOne');original=await paused(original);assert.deepEqual((await p.readTextDefinitionForReview('sql',names.sql)).value,values.sql);assert.equal((await p.readTextDefinitionForReview('html',names.html)).value,null);});
 let leaf=await remaining(original);
 await check('Rendered remaining work and fresh primary approval apply CSS before its referring HTML with exact complete checkpoints',async()=>{assert.equal(leaf.continuation.prerequisites.length,1);assert.ok(leaf.objects.every((o:any)=>o.review==='PENDING'));leaf=await approveApply(leaf);for(const kind of ['sql','stylesheet','html'] as const)assert.deepEqual((await p.readTextDefinitionForReview(kind,names[kind])).value,values[kind]);});
 let inverse=await call('psft_prepare_revert',{changeSetId:leaf.id});const inverseRoot=inverse.id;
 await check('Rendered destructive approval can pause after HTML deletion without reverting incomplete source histories',async()=>{await call('psft_validate_change_set',{changeSetId:inverse.id});inverse=await get(inverse.id);assert.equal(inverse.status,'READY_FOR_REVIEW',JSON.stringify(inverse.objects.map((o:any)=>o.validation)));await open(inverse);await ui.webviewAction('PeopleSoft Change Review','checkbox','destructive');await click(inverse,'approve');inverse=await wait(async()=>{const s=await get(inverse.id);return s.status==='APPROVED'?s:false;},'inverse approval');await click(inverse,'applyOne');inverse=await paused(inverse);assert.equal((await p.readTextDefinitionForReview('html',names.html,true)).deleted,true);assert.deepEqual((await p.readTextDefinitionForReview('stylesheet',names.stylesheet)).value,values.stylesheet);assert.equal((await get(original.id)).status,'PARTIALLY_APPLIED');assert.equal((await get(leaf.id)).status,'APPLIED');await ui.screenshot(control.dir+'/text-installed-paused-inverse.png');});
 inverse=await remaining(inverse);
 await check('Fresh rendered schema-4 undo continuation checks the deleted HTML prerequisite and deletes only remaining CSS/SQL',async()=>{assert.equal(inverse.schema,4);assert.equal(inverse.objects.length,2);assert.equal(inverse.continuation.prerequisites.length,1);inverse=await approveApply(inverse,true);for(const kind of ['sql','stylesheet','html'] as const)assert.equal((await p.readTextDefinitionForReview(kind,names[kind],true)).deleted,true);assert.equal((await get(original.id)).status,'REVERTED');assert.equal((await get(leaf.id)).status,'REVERTED');const page=await open(await get(inverseRoot));assert.match(page.text,/Remaining work completed in/);await ui.screenshot(control.dir+'/text-installed-inverse.png');});
 let redo:any;await open(await get(original.id));await click(await get(original.id),'redo');redo=await wait(async()=>(await sets()).find(s=>s.reverses===inverse.id&&s.status==='DRAFT'),'redo from original history');
 await check('Rendered fresh redo from original history restores all metadata/text and clears calibrated tombstones',async()=>{redo=await approveApply(redo);for(const kind of ['sql','stylesheet','html'] as const)assert.deepEqual((await p.readTextDefinitionForReview(kind,names[kind])).value,values[kind]);const sql=redo.objects.find((o:any)=>o.adapter==='sql-definition');const timeline=await call('psft_get_object_timeline',{changeSetId:redo.id,objectId:sql.id,checkLive:true});assert.equal(timeline.live.status,'MATCHES_RECORDED');await ui.screenshot(control.dir+'/text-installed-redo.png');});
 report.changeSets=[original.id,leaf.id,inverseRoot,inverse.id,redo.id];
 for(const name of ['text-installed-before','text-installed-paused-inverse','text-installed-inverse','text-installed-redo'])await copyFile(control.dir+'/'+name+'.png','tools/lab/results/'+name+'-2026-10-20.png');
 report.passed=true;
}catch(error){report.error=error instanceof Error?error.message:String(error);throw error;}
finally{try{if((await sets()).some(s=>s.status==='APPLYING'))throw Error('A writer is still active; refusing concurrent fixture cleanup.');await cleanup();report.cleanupVerified=(await Promise.all((['sql','html','stylesheet'] as const).map(k=>p.readTextDefinitionForReview(k,names[k])))).every(s=>s.token==='absent');}finally{await writeFile('tools/lab/results/text-reversal-installed-2026-10-20.json',JSON.stringify(report,null,2)+'\n');await c.close();await pool.close();await p.dispose();ui.close();}}
